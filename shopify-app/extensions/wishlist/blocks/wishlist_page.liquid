<div
  id="wishlist-page-root"
  class="wishlist-page"
  data-heading="{{ block.settings.heading | escape }}"
  data-empty-text="{{ block.settings.empty_text | escape }}"
  data-login-url="{{ routes.account_login_url }}"
>
  <h1 class="wishlist-page__heading">{{ block.settings.heading }}</h1>
  <div class="wishlist-page__status">Loading wishlist...</div>
  <div class="wishlist-page__grid" hidden></div>
</div>

{% schema %}
{
  "name": "Wishlist page",
  "target": "section",
  "javascript": "wishlist-page.js",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My wishlist"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty message",
      "default": "Your wishlist is empty."
    }
  ]
}
{% endschema %}
